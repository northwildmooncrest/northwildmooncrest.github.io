{
  "site": "Northwild Mooncrest",
  "version": "2026.09",
  "ariaMap": {
    "header": {
      "role": "banner",
      "elements": {
        "brandTitle": "heading",
        "brandSubtitle": "text",
        "navigation": {
          "role": "navigation",
          "links": ["Gallery", "Journeys", "About", "Contact"]
        }
      }
    },

    "hero": {
      "role": "region",
      "label": "Hero Section",
      "elements": {
        "heading": "heading",
        "text": "paragraph",
        "cta": "button"
      }
    },

    "gallery": {
      "role": "region",
      "label": "Gallery",
      "elements": {
        "filters": {
          "role": "toolbar",
          "buttons": ["All", "Mountains", "Forest", "Water", "Night"]
        },
        "grid": {
          "role": "list",
          "items": "listitem"
        }
      }
    },

    "accessibilityHub": {
      "role": "region",
      "label": "Accessibility Settings",
      "elements": {
        "highContrast": "button",
        "dyslexiaMode": "button",
        "screenreaderMode": "button",
        "keyboardNavigation": "button",
        "ariaMapLink": "link"
      }
    },

    "footer": {
      "role": "contentinfo",
      "elements": {
        "brand": "heading",
        "columns": {
          "legal": "list",
          "account": "list",
          "global": "list",
          "support": "list",
          "experience": "list"
        },
        "copyright": "text"
      }
    }
  }
}
